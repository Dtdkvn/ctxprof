# The proxy listens only on loopback unless --allow-remote is supplied.
CTXPROF_PORT=8787
CTXPROF_HOST=127.0.0.1
CTXPROF_DATA=.ctxprof
CTXPROF_UPSTREAM=https://api.openai.com
CTXPROF_CAPTURE=redacted

# Optional. Incoming Authorization headers take precedence and are never stored.
# OPENAI_API_KEY=sk-...
