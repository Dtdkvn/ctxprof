{
  "name": "ctxprof",
  "version": "0.1.0",
  "description": "A local-first context-window profiler and CI budget gate for OpenAI-compatible LLM apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ctxprof": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples/github-actions/context-budget.yml",
    "ctxprof.config.json",
    "ctxprof.pricing.example.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "build:action": "npm run build && node scripts/build-action.mjs",
    "check:action": "node scripts/build-action.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build:test && node scripts/run-tests.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:action",
    "dev": "node --enable-source-maps --import=tsx src/cli.ts",
    "demo": "npm run build && node dist/cli.js demo",
    "benchmark:store": "npm run build && node scripts/benchmark-store.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:action": "node scripts/smoke-action.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "llm",
    "openai",
    "prompt",
    "tokens",
    "profiler",
    "context-window",
    "ai-observability",
    "github-action"
  ],
  "author": "Ctxprof contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dtdkvn/ctxprof.git"
  },
  "bugs": {
    "url": "https://github.com/Dtdkvn/ctxprof/issues"
  },
  "homepage": "https://github.com/Dtdkvn/ctxprof#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
